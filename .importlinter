[importlinter:contract:ne-chat-interface-lane]
name = ne-chat is an interface adapter (no heavy-plane imports)
type = forbidden
# Direct-import check only: ne.chat legitimately depends on ne.runtime (gate
# types/errors), and ne.runtime transitively pulls ne.govern/ne.envbuild — that
# indirect chain is fine. What must never happen is ne.chat DIRECTLY importing a
# heavy plane (esp. litellm-dragging ne.gateway); the model path is ONLY the
# frozen ModelGateway injected inside ne-runtime sessions.
allow_indirect_imports = True
source_modules =
    ne.chat
forbidden_modules =
    ne.api
    ne.gateway
    ne.brain
    ne.brain_graph
    ne.brain_ontology
    ne.connect
    ne.serve
    ne.mcp
    ne.eval
    ne.flywheel
    ne.cli
    ne.envbuild

