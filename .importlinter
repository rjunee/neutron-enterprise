[importlinter:contract:c3-provider-sdk-chokepoint]
name = C3: provider SDKs / litellm only via ne.gateway._litellm
type = forbidden
source_modules =
    ne.acme
    ne.acme_seed
    ne.meridian
    ne.meridian_seed
    ne.api
    ne.audit
    ne.backup
    ne.brain
    ne.brain_graph
    ne.brain_ontology
    ne.chat
    ne.cli
    ne.connect
    ne.contracts
    ne.envbuild
    ne.eval
    ne.events
    ne.flywheel
    ne.gateway
    ne.govern
    ne.identity
    ne.inference_operator
    ne.mcp
    ne.memory_graph
    ne.model_export
    ne.net
    ne.obs
    ne.permissions
    ne.permissions_rebac
    ne.runtime
    ne.schema
    ne.schema_bootstrap
    ne.secrets
    ne.serve
    ne.skills
    ne.skills_cc
    ne.storage
    ne.worker
forbidden_modules =
    litellm
    openai
    anthropic
    mistralai
    cohere
    groq
    ollama
    together
    replicate
ignore_imports =
    ne.gateway._litellm -> litellm

[importlinter:contract:ne-api-decoration-free]
name = NE-103c: ne-api never imports the worker/durable-decorated modules
# Keeps ne-api's import graph decoration-free so BOTH processes can safely run
# NE_RUNTIME_DURABILITY=dbos: the @ne_workflow/@ne_step decorators fire at
# import/decoration time, and ne-api must never pull a decorated module into its
# graph (it enqueues by NAME via DBOSClient — design §6.2(i)). ne.worker.* and
# ne.runtime.approvals_durable are the decorated modules.
type = forbidden
source_modules =
    ne.api
forbidden_modules =
    ne.worker
    ne.runtime.approvals_durable

