{
    "$defs": {
        "Account": {
            "additionalProperties": false,
            "description": "An organization the enterprise does business with \u2014 a customer, prospect, or partner company. The anchor entity most other records associate to.",
            "properties": {
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "domain": {
                    "description": "Primary web domain for the account (lowercased, e.g. \"acme.com\").",
                    "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "employee_count": {
                    "description": "Approximate number of employees at the account.",
                    "minimum": 0,
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "id": {
                    "description": "Platform-canonical entity id (stable, unique within the platform).",
                    "type": "string"
                },
                "industry": {
                    "description": "Industry or vertical the account operates in.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "description": "Human-readable account (company) name.",
                    "type": "string"
                },
                "source_record_id": {
                    "description": "The entity's native primary key in its source system.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_system": {
                    "description": "Name of the upstream system of record this entity was ingested from (e.g. \"salesforce\", \"zendesk\", \"netsuite\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "$ref": "#/$defs/AccountStatus",
                    "description": "Lifecycle status of the account relationship."
                },
                "updated_at": {
                    "description": "Timestamp the entity was last modified in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "name",
                "id"
            ],
            "title": "Account",
            "type": "object"
        },
        "AccountStatus": {
            "description": "Lifecycle status of an Account relationship.",
            "enum": [
                "prospect",
                "active",
                "churned"
            ],
            "title": "AccountStatus",
            "type": "string"
        },
        "AutoLoan": {
            "additionalProperties": false,
            "description": "A Meridian auto loan connected from its Customer and carrying the bounded servicing attributes used by the disaster-hardship control.",
            "properties": {
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "has_payment_schedule": {
                    "description": "References (by id) to PaymentSchedules belonging to this AutoLoan.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "has_servicing_note": {
                    "description": "References (by id) to ServicingNotes attributable to this AutoLoan.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "id": {
                    "description": "Platform-canonical entity id (stable, unique within the platform).",
                    "type": "string"
                },
                "loan_identifier": {
                    "description": "Stable Meridian auto-loan identifier.",
                    "pattern": "^mer-loan-[0-9]{3}$",
                    "type": "string"
                },
                "next_due_date": {
                    "description": "Next payment due date recorded on the auto loan.",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "type": "string"
                },
                "principal_balance_cents": {
                    "description": "Outstanding principal balance in integer cents.",
                    "minimum": 0,
                    "type": "integer"
                },
                "source_record_id": {
                    "description": "The entity's native primary key in its source system.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_system": {
                    "description": "Name of the upstream system of record this entity was ingested from (e.g. \"salesforce\", \"zendesk\", \"netsuite\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "$ref": "#/$defs/AutoLoanStatus",
                    "description": "Current servicing status of the auto loan."
                },
                "updated_at": {
                    "description": "Timestamp the entity was last modified in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "loan_identifier",
                "status",
                "principal_balance_cents",
                "next_due_date",
                "has_payment_schedule",
                "has_servicing_note",
                "id"
            ],
            "title": "AutoLoan",
            "type": "object"
        },
        "AutoLoanStatus": {
            "description": "Servicing status of a Meridian AutoLoan.",
            "enum": [
                "active",
                "paid_off",
                "repossession"
            ],
            "title": "AutoLoanStatus",
            "type": "string"
        },
        "Customer": {
            "additionalProperties": false,
            "description": "A Meridian retail-banking customer. The bounded Tier-2 projection carries the stable corpus identifier, human name, county, and lifecycle status needed to anchor the governed disaster-hardship graph path.",
            "properties": {
                "county": {
                    "description": "County from the customer's source address.",
                    "type": "string"
                },
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "customer_identifier": {
                    "description": "Stable Meridian customer identifier.",
                    "pattern": "^mer-cus-[0-9]{3}$",
                    "type": "string"
                },
                "first_name": {
                    "description": "Customer's given name.",
                    "type": "string"
                },
                "has_auto_loan": {
                    "description": "References (by id) to the customer's AutoLoans. This is optional because a Customer may have no auto loan in the governed corpus.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "has_servicing_note": {
                    "description": "References (by id) to ServicingNotes attributable to this Customer.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "id": {
                    "description": "Platform-canonical entity id (stable, unique within the platform).",
                    "type": "string"
                },
                "last_name": {
                    "description": "Customer's family name.",
                    "type": "string"
                },
                "source_record_id": {
                    "description": "The entity's native primary key in its source system.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_system": {
                    "description": "Name of the upstream system of record this entity was ingested from (e.g. \"salesforce\", \"zendesk\", \"netsuite\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "$ref": "#/$defs/CustomerStatus",
                    "description": "Lifecycle status of the customer record."
                },
                "updated_at": {
                    "description": "Timestamp the entity was last modified in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "customer_identifier",
                "first_name",
                "last_name",
                "county",
                "status",
                "id"
            ],
            "title": "Customer",
            "type": "object"
        },
        "CustomerStatus": {
            "description": "Lifecycle status of a Meridian Customer record.",
            "enum": [
                "active",
                "inactive"
            ],
            "title": "CustomerStatus",
            "type": "string"
        },
        "Document": {
            "additionalProperties": false,
            "description": "A piece of enterprise content \u2014 a contract, invoice, report, policy, or other file \u2014 authored by a Person, owned by a Person, and about one or more Accounts.",
            "properties": {
                "about": {
                    "description": "References (by id) to the Accounts this document concerns. A document may pertain to multiple accounts.",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "author": {
                    "description": "Reference (by id) to the Person who authored the document.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "doc_type": {
                    "$ref": "#/$defs/DocumentType",
                    "description": "The kind of document this is."
                },
                "id": {
                    "description": "Platform-canonical entity id (stable, unique within the platform).",
                    "type": "string"
                },
                "mime_type": {
                    "description": "IANA media type of the document content (e.g. \"application/pdf\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "owned_by": {
                    "description": "Reference (by id) to the Person who owns/is accountable for the document.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_record_id": {
                    "description": "The entity's native primary key in its source system.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_system": {
                    "description": "Name of the upstream system of record this entity was ingested from (e.g. \"salesforce\", \"zendesk\", \"netsuite\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "title": {
                    "description": "Human-readable document title.",
                    "type": "string"
                },
                "updated_at": {
                    "description": "Timestamp the entity was last modified in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "uri": {
                    "description": "Location of the document's content (object-store or external URI).",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "title",
                "doc_type",
                "id"
            ],
            "title": "Document",
            "type": "object"
        },
        "DocumentType": {
            "description": "The kind of a Document.",
            "enum": [
                "contract",
                "invoice",
                "report",
                "policy",
                "presentation",
                "correspondence",
                "other"
            ],
            "title": "DocumentType",
            "type": "string"
        },
        "OperationalEntity": {
            "additionalProperties": false,
            "description": "Abstract base for every operational entity. Carries the platform-canonical identity and source-provenance slots shared by all records.",
            "properties": {
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
                    "description": "Platform-canonical entity id (stable, unique within the platform).",
                    "type": "string"
                },
                "source_record_id": {
                    "description": "The entity's native primary key in its source system.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_system": {
                    "description": "Name of the upstream system of record this entity was ingested from (e.g. \"salesforce\", \"zendesk\", \"netsuite\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "updated_at": {
                    "description": "Timestamp the entity was last modified in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "id"
            ],
            "title": "OperationalEntity",
            "type": "object"
        },
        "OperationalRecordSet": {
            "additionalProperties": false,
            "description": "Top-level container binding a set of operational entities together \u2014 the root of a validated operational graph. Used as the JSON Schema root class.",
            "properties": {
                "accounts": {
                    "description": "The Accounts in this record set.",
                    "items": {
                        "$ref": "#/$defs/Account"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "auto_loans": {
                    "description": "The Meridian AutoLoans in this record set.",
                    "items": {
                        "$ref": "#/$defs/AutoLoan"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "customers": {
                    "description": "The Meridian Customers in this record set.",
                    "items": {
                        "$ref": "#/$defs/Customer"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "documents": {
                    "description": "The Documents in this record set.",
                    "items": {
                        "$ref": "#/$defs/Document"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "orders": {
                    "description": "The Orders in this record set.",
                    "items": {
                        "$ref": "#/$defs/Order"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "payment_schedules": {
                    "description": "The Meridian PaymentSchedules in this record set.",
                    "items": {
                        "$ref": "#/$defs/PaymentSchedule"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "people": {
                    "description": "The People in this record set.",
                    "items": {
                        "$ref": "#/$defs/Person"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "servicing_notes": {
                    "description": "The Meridian ServicingNotes in this record set.",
                    "items": {
                        "$ref": "#/$defs/ServicingNote"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "tickets": {
                    "description": "The Tickets in this record set.",
                    "items": {
                        "$ref": "#/$defs/Ticket"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "title": "OperationalRecordSet",
            "type": "object"
        },
        "Order": {
            "additionalProperties": false,
            "description": "A commercial order placed against an Account by a Person, with a monetary total and currency.",
            "properties": {
                "account": {
                    "description": "Reference (by id) to the Account the order is placed against.",
                    "type": "string"
                },
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "currency": {
                    "description": "ISO 4217 three-letter currency code (e.g. \"USD\").",
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                },
                "id": {
                    "description": "Platform-canonical entity id (stable, unique within the platform).",
                    "type": "string"
                },
                "order_number": {
                    "description": "Human-readable order number (e.g. \"ORD-0001\").",
                    "pattern": "^ORD-[0-9]{4,}$",
                    "type": "string"
                },
                "placed_at": {
                    "description": "Timestamp the order was placed.",
                    "format": "date-time",
                    "type": "string"
                },
                "placed_by": {
                    "description": "Reference (by id) to the Person who placed the order.",
                    "type": "string"
                },
                "source_record_id": {
                    "description": "The entity's native primary key in its source system.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_system": {
                    "description": "Name of the upstream system of record this entity was ingested from (e.g. \"salesforce\", \"zendesk\", \"netsuite\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "$ref": "#/$defs/OrderStatus",
                    "description": "Fulfillment status of the order."
                },
                "total_amount": {
                    "description": "Total monetary amount of the order in the given currency.",
                    "minimum": 0,
                    "type": "number"
                },
                "updated_at": {
                    "description": "Timestamp the entity was last modified in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "order_number",
                "account",
                "placed_by",
                "status",
                "currency",
                "total_amount",
                "placed_at",
                "id"
            ],
            "title": "Order",
            "type": "object"
        },
        "OrderStatus": {
            "description": "Fulfillment status of an Order.",
            "enum": [
                "draft",
                "placed",
                "fulfilled",
                "cancelled",
                "refunded"
            ],
            "title": "OrderStatus",
            "type": "string"
        },
        "PaymentSchedule": {
            "additionalProperties": false,
            "description": "A scheduled Meridian auto-loan payment used to determine whether an unpaid payment falls inside the governed due-date window.",
            "properties": {
                "amount_cents": {
                    "description": "Scheduled payment amount in integer cents.",
                    "minimum": 0,
                    "type": "integer"
                },
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "due_date": {
                    "description": "Date on which the payment is due.",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "type": "string"
                },
                "id": {
                    "description": "Platform-canonical entity id (stable, unique within the platform).",
                    "type": "string"
                },
                "payment_identifier": {
                    "description": "Stable Meridian payment-schedule identifier.",
                    "pattern": "^mer-pay-[0-9]{3}$",
                    "type": "string"
                },
                "source_record_id": {
                    "description": "The entity's native primary key in its source system.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_system": {
                    "description": "Name of the upstream system of record this entity was ingested from (e.g. \"salesforce\", \"zendesk\", \"netsuite\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "$ref": "#/$defs/PaymentScheduleStatus",
                    "description": "Current state of the scheduled payment."
                },
                "updated_at": {
                    "description": "Timestamp the entity was last modified in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "payment_identifier",
                "due_date",
                "amount_cents",
                "status",
                "id"
            ],
            "title": "PaymentSchedule",
            "type": "object"
        },
        "PaymentScheduleStatus": {
            "description": "State of a Meridian PaymentSchedule.",
            "enum": [
                "scheduled",
                "paid",
                "cancelled"
            ],
            "title": "PaymentScheduleStatus",
            "type": "string"
        },
        "Person": {
            "additionalProperties": false,
            "description": "An individual \u2014 a contact, employee, or user \u2014 typically associated with an Account. People author Documents and are the requesters/assignees of Tickets and the placers of Orders.",
            "properties": {
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "email": {
                    "description": "The person's primary email address.",
                    "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                    "type": "string"
                },
                "family_name": {
                    "description": "The person's family (last) name.",
                    "type": "string"
                },
                "given_name": {
                    "description": "The person's given (first) name.",
                    "type": "string"
                },
                "id": {
                    "description": "Platform-canonical entity id (stable, unique within the platform).",
                    "type": "string"
                },
                "is_active": {
                    "description": "Whether the person is currently active (not disabled/departed).",
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "phone": {
                    "description": "The person's contact phone number (free-form).",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_record_id": {
                    "description": "The entity's native primary key in its source system.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_system": {
                    "description": "Name of the upstream system of record this entity was ingested from (e.g. \"salesforce\", \"zendesk\", \"netsuite\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "title": {
                    "description": "The person's job title or role.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "updated_at": {
                    "description": "Timestamp the entity was last modified in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "works_at": {
                    "description": "Reference (by id) to the Account this person works at. Tier-1 id link; becomes a typed relation at Tier 2.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "given_name",
                "family_name",
                "email",
                "id"
            ],
            "title": "Person",
            "type": "object"
        },
        "ServicingNote": {
            "additionalProperties": false,
            "description": "A Meridian servicing note whose typed classification supplies the recorded hardship-offer or repossession fact used by the eligibility path.",
            "properties": {
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "created_date": {
                    "description": "Date the servicing note was created.",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "type": "string"
                },
                "id": {
                    "description": "Platform-canonical entity id (stable, unique within the platform).",
                    "type": "string"
                },
                "note_identifier": {
                    "description": "Stable Meridian servicing-note identifier.",
                    "pattern": "^mer-note-[0-9]{3}$",
                    "type": "string"
                },
                "note_type": {
                    "$ref": "#/$defs/ServicingNoteType",
                    "description": "Typed servicing fact recorded by the note."
                },
                "source_record_id": {
                    "description": "The entity's native primary key in its source system.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_system": {
                    "description": "Name of the upstream system of record this entity was ingested from (e.g. \"salesforce\", \"zendesk\", \"netsuite\").",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "text": {
                    "description": "Source-authored servicing note text.",
                    "type": "string"
                },
                "ticket_identifier": {
                    "description": "Stable Meridian servicing-ticket identifier carried by the note.",
                    "pattern": "^mer-tkt-[0-9]{3}$",
                    "type": "string"
                },
                "updated_at": {
                    "description": "Timestamp the entity was last modified in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "note_identifier",
                "ticket_identifier",
                "note_type",
                "created_date",
                "text",
                "id"
            ],
            "title": "ServicingNote",
            "type": "object"
        },
        "ServicingNoteType": {
            "description": "Typed fact recorded by a Meridian ServicingNote.",
            "enum": [
                "contact",
                "hardship_offered",
                "repossession",
                "resolution"
            ],
            "title": "ServicingNoteType",
            "type": "string"
        },
        "Ticket": {
            "additionalProperties": false,
            "description": "A support or service request belonging to an Account, raised by a requester Person and worked by an assignee Person.",
            "properties": {
                "assignee": {
                    "description": "Reference (by id) to the Person assigned to work the ticket.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "belongs_to": {
                    "description": "Reference (by id) to the Account this ticket belongs to.",
                    "type": "string"
                },
                "created_at": {
                    "description": "Timestamp the entity was first created in its source system.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "description": {
                    "description": "Full free-text description of the issue or request.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "id": {
