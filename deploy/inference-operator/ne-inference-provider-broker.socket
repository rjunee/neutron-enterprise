[Unit]
Description=Stable socket for the Neutron non-root inference provider broker

[Socket]
ListenStream=/run/neutron/inference-provider/provider.sock
FileDescriptorName=inference-provider
SocketUser=root
SocketGroup=10001
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=true

[Install]
WantedBy=sockets.target
