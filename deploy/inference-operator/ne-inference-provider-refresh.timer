[Unit]
Description=Refresh Neutron inference provider network evidence before expiry

[Timer]
OnBootSec=5min
OnUnitActiveSec=12h
RandomizedDelaySec=5min
Persistent=true
Unit=ne-inference-provider-refresh.service

[Install]
WantedBy=timers.target
