{
  "realm": "ne-pilot",
  "enabled": true,
  "accessTokenLifespan": 900,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "entra-groups-overage",
        "description": "Marker role granted by the entra overage IdP mappers when Entra omits the groups claim (overage indicator). Never read by ne-identity; exists only so the entra post-broker-login flow can deny login instead of silently under-authorizing."
      }
    ]
  },
  "groups": [
    {
      "name": "all-employees",
      "path": "/all-employees"
    },
    {
      "name": "approver",
      "path": "/approver"
