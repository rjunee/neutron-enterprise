  "clients": [
    {
      "clientId": "ne-console",
      "name": "Neutron Enterprise console (public SPA)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${NE_PILOT_HOSTNAME}/##https://${NE_PILOT_HOSTNAME}:443/"
      },
      "redirectUris": [
        "https://${NE_PILOT_HOSTNAME}/auth/callback",
        "https://${NE_PILOT_HOSTNAME}/auth/compare-callback",
        "https://${NE_PILOT_HOSTNAME}:443/auth/callback",
        "https://${NE_PILOT_HOSTNAME}:443/auth/compare-callback"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "ne-groups",
        "ne-console-audience",
        "ne-department"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "entra",
      "displayName": "Sign in with Microsoft Entra ID",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "postBrokerLoginFlowAlias": "entra post broker login",
      "config": {
        "issuer": "https://login.microsoftonline.com/${NE_PILOT_ENTRA_TENANT_ID}/v2.0",
        "authorizationUrl": "https://login.microsoftonline.com/${NE_PILOT_ENTRA_TENANT_ID}/oauth2/v2.0/authorize",
        "tokenUrl": "https://login.microsoftonline.com/${NE_PILOT_ENTRA_TENANT_ID}/oauth2/v2.0/token",
        "jwksUrl": "https://login.microsoftonline.com/${NE_PILOT_ENTRA_TENANT_ID}/discovery/v2.0/keys",
        "clientId": "${NE_PILOT_ENTRA_BROKER_CLIENT_ID}",
        "clientSecret": "${NE_PILOT_ENTRA_BROKER_CLIENT_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid profile email",
        "syncMode": "FORCE",
        "validateSignature": "true",
        "useJwksUrl": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "entra-groups-approver",
      "identityProviderAlias": "entra",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claims": "[{\"key\":\"groups\",\"value\":\"REPLACE-ENTRA-GROUP-ID-approver\"}]",
        "are.claim.values.regex": "false",
        "group": "/approver"
      }
    },
    {
      "name": "entra-groups-steward",
      "identityProviderAlias": "entra",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claims": "[{\"key\":\"groups\",\"value\":\"REPLACE-ENTRA-GROUP-ID-steward\"}]",
        "are.claim.values.regex": "false",
        "group": "/steward"
      }
    },
    {
      "name": "entra-groups-ops",
      "identityProviderAlias": "entra",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claims": "[{\"key\":\"groups\",\"value\":\"REPLACE-ENTRA-GROUP-ID-ops\"}]",
        "are.claim.values.regex": "false",
        "group": "/ops"
      }
    },
    {
      "name": "entra-groups-overage-indicator",
      "identityProviderAlias": "entra",
      "identityProviderMapper": "oidc-advanced-role-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claims": "[{\"key\":\"_claim_names.groups\",\"value\":\".+\"}]",
        "are.claim.values.regex": "true",
        "role": "entra-groups-overage"
      }
    },
    {
      "name": "entra-groups-overage-hasgroups",
      "identityProviderAlias": "entra",
      "identityProviderMapper": "oidc-advanced-role-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claims": "[{\"key\":\"hasgroups\",\"value\":\"true\"}]",
        "are.claim.values.regex": "true",
        "role": "entra-groups-overage"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "entra post broker login",
      "description": "Fail-loud on Entra groups-overage: deny the login instead of silently resolving to zero platform groups (design §4.2-2).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "entra groups overage check",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "entra groups overage check",
      "description": "Conditional subflow: if the entra-groups-overage marker role is present, deny access.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "entra-overage-condition",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "entra-overage-deny",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "entra-overage-condition",
      "config": {
        "condUserRole": "entra-groups-overage",
        "negate": "false"
      }
    },
    {
      "alias": "entra-overage-deny",
      "config": {
        "denyErrorMessage": "Sign-in blocked: Microsoft Entra omitted your groups claim (group overage), so your platform roles cannot be determined. Contact your administrator to assign your platform groups to the broker app registration (Entra broker runbook, 'Group overage')."
      }
    }
  ],
