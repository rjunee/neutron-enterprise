#
# Flowise add-on (NE-088) secret template. C12: resolve every value from your
# secret store at bring-up; NEVER commit real values. Each maps to a required
# ${...:?} interpolation in deploy/compose/flowise/compose.yaml, so a missing
# value fails the compose invocation LOUD (fail closed) instead of booting weak.
#
# Bring up with, e.g.:
#   docker compose --env-file <secure-env> -f deploy/compose/flowise/compose.yaml \
#     --profile flowise up -d

# Flowise app-level encryption key (encrypts stored credentials).
NE_FLOWISE_SECRETKEY=

# Flowise auth token / session secrets.
NE_FLOWISE_JWT_AUTH_SECRET=
NE_FLOWISE_JWT_REFRESH_SECRET=
NE_FLOWISE_SESSION_SECRET=
NE_FLOWISE_TOKEN_HASH_SECRET=

# (H3) EXPLICIT ACCEPT-THE-RISK ENABLE-GATE — NOT a secret, an acknowledgment.
# Flowise carries CVE-2025-59528 (CVSS 10.0 KEV RCE, patched in the pinned 3.1.4
# and mitigated by the disabled code-exec node class + off-by-default posture).
# The overlay REFUSES to start unless this is EXACTLY the string true — at BOTH
# compose config-time (a required :? interpolation) AND container runtime (an
# entrypoint equality check). Leaving it empty/unset makes `docker compose
# --profile flowise config|up` fail loud; any value other than true crash-loops
# the container by design. Read the "Risk acceptance" section of README.md, then
# set it to true to consciously accept the residual risk.
NE_FLOWISE_ACCEPT_CVE_RISK=
