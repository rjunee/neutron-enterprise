{
  "realm": "ne-dev",
  "enabled": true,
  "accessTokenLifespan": 900,
  "groups": [
    { "name": "platform-admins", "path": "/platform-admins" },
    { "name": "engineering", "path": "/engineering" }
  ],
  "clientScopes": [
    {
      "name": "ne-groups",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "ne-identity-provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "identity_provider",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "ne-api-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "ne-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ne-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ne-console",
      "publicClient": true,
      "enabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["+"],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "ne-groups",
        "ne-api-audience"
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "ne-admin" }
    ]
  },
  "identityProviders": [
    {
      "alias": "customer-idp",
      "displayName": "Customer IdP (broker placeholder — see README)",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "config": {
        "issuer": "https://idp.customer.example",
        "authorizationUrl": "https://idp.customer.example/authorize",
        "tokenUrl": "https://idp.customer.example/token",
        "clientId": "neutron-enterprise",
        "clientSecret": "REPLACE-PER-CUSTOMER",
        "clientAuthMethod": "client_secret_post",
        "syncMode": "FORCE"
      }
    }
  ],
  "users": [
    {
      "username": "dev",
      "email": "dev@ne.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["ne-admin"],
      "groups": ["/platform-admins"]
    }
  ]
}
