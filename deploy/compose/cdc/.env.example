#
# NE-084 CDC lane environment TEMPLATE — copy to a 0600 env file resolved from
# your secret store at bring-up. NEVER commit real values. Every NE_CDC_* value
# below is a REQUIRED (${...:?}) interpolation in compose.yaml / pilot-override.yaml.

# --- shared webhook secret (Standard Webhooks; same value on Debezium AND ne-api)
# Generate: NE_CDC_WEBHOOK_SECRET="whsec_$(openssl rand -base64 32)"
NE_CDC_WEBHOOK_SECRET=

# --- the governed per-table map (JSON for ne.connect.cdc.CdcSinkConfig.from_json)
# Example (one table, per-row ACL from a column):
# NE_CDC_TABLES='{"source_name":"debezium","tables":{"public.customers":{"key_columns":["id"],"content_columns":["name","email"],"acl":{"principal_column":"acl_group"}}}}'
NE_CDC_TABLES=

# --- source database (Debezium connects OUTBOUND to this; never published)
NE_CDC_SOURCE_DB_HOST=
NE_CDC_SOURCE_DB_PORT=5432
NE_CDC_SOURCE_DB_USER=
NE_CDC_SOURCE_DB_PASSWORD=
NE_CDC_SOURCE_DB_NAME=
# Comma-separated schema.table list Debezium captures (e.g. public.customers).
NE_CDC_TABLE_INCLUDE_LIST=
# initial (snapshot then stream) | never (stream only) | ... — see README.
NE_CDC_SNAPSHOT_MODE=initial
