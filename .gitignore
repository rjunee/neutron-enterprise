*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.DS_Store
node_modules/
# ...and a SYMLINK named node_modules: the trailing-slash rule above matches
# directories only, so a worktree-local symlink slipped into a commit (dd9dbd89).
node_modules
.env

# rendered intermediate (regenerated by build-pdf.sh)
docs/whitepaper/*.html

# module companion videos (not tracked in git)
docs/course/videos/*.mp4

# ne demo runtime workdir (bundle/secret-store/models/corpus/dossier) — never commit (secrets)
/ne-demo/

# Demo host state written into the checkout root. Declared non-source state,
# root-anchored.
/.ne-*
/meridian-workflows-overlay.yaml
/demo-seed/
